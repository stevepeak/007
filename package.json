{
  "name": "@stevepeak/007",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Whitelabeled AI-workflow SDK — host-injected engine, Cloudflare Workflows execution, SQL storage, and editor/run-viewer UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevepeak/007.git"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/analytics/index.ts",
    "./cloudflare": "./src/cloudflare/index.ts",
    "./cloudflare/analytics-engine": "./src/cloudflare/analytics-engine.ts",
    "./cloudflare/blob-resolver": "./src/cloudflare/blob-resolver.ts",
    "./cloudflare/extract-text": "./src/cloudflare/extract-text.ts",
    "./cloudflare/runtime": "./src/cloudflare/runtime.ts",
    "./engine": "./src/engine/index.ts",
    "./eval": "./src/eval/index.ts",
    "./server": "./src/server/index.ts",
    "./storage": "./src/storage/index.ts",
    "./storage/schema": "./src/storage/schema.ts",
    "./tools": "./src/tools/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/run-progress": "./src/ui/run-progress.ts",
    "./ui/styles.css": "./src/ui/styles.css"
  },
  "bin": {
    "wf-dump-run": "./src/cli/dump-run.ts",
    "wf-spec": "./src/cli/spec.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules dist .turbo",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "bun test",
    "lint": "eslint --ignore-pattern='./migrations/' .",
    "fix": "eslint --fix --quiet --ignore-pattern='./migrations/' .",
    "lock": "sh -c 'd=$(mktemp -d); cp package.json bun.lock \"$d\"; (cd \"$d\" && bun install --lockfile-only); cp \"$d/bun.lock\" ./bun.lock; rm -rf \"$d\"; echo \"[007] bun.lock regenerated standalone\"'",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "sh -c '[ -f ../../.wf-migrate.env ] && . ../../.wf-migrate.env; wrangler d1 migrations apply ${WF_D1_NAME:-DB} --local --persist-to ${WF_D1_STATE:-../../.wrangler/state} --config ${WF_D1_CONFIG:-./wrangler.jsonc}'",
    "db:migrate": "sh -c '[ -f ../../.wf-migrate.env ] && . ../../.wf-migrate.env; wrangler d1 migrations apply ${WF_D1_NAME:-DB} --remote --config ${WF_D1_CONFIG:-./wrangler.jsonc}'"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.65",
    "@autoform/core": "^4.0.0",
    "@autoform/react": "^5.0.0",
    "@cloudflare/puppeteer": "1.3.0",
    "@dagrejs/dagre": "^3.1.1",
    "@hookform/resolvers": "^5.7.1",
    "@sentry/cloudflare": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-placeholder": "^3.30.0",
    "@tiptap/extensions": "^3.30.0",
    "@tiptap/markdown": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@xyflow/react": "^12.11.3",
    "ai": "^7.0.62",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "react-hook-form": "^7.85.0",
    "react-is": "^19.2.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@dexaai/config": "^0.0.10",
    "@ocavue/eslint-config": "^4.13.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.8",
    "eslint": "^10.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "wrangler": "^4.121.0"
  }
}
