{
  "name": "@stevepeak/007",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Whitelabeled AI-workflow SDK — host-injected engine, Cloudflare Workflows execution, SQL storage, and editor/run-viewer UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevepeak/007.git"
  },
  "main": "src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/analytics/index.ts",
    "./cloudflare": "./src/cloudflare/index.ts",
    "./cloudflare/analytics-engine": "./src/cloudflare/analytics-engine.ts",
    "./cloudflare/blob-resolver": "./src/cloudflare/blob-resolver.ts",
    "./cloudflare/blob-spill": "./src/cloudflare/blob-spill.ts",
    "./cloudflare/extract-text": "./src/cloudflare/extract-text.ts",
    "./cloudflare/runtime": "./src/cloudflare/runtime.ts",
    "./documents": "./src/documents/index.ts",
    "./references": "./src/engine/references.ts",
    "./engine": "./src/engine/index.ts",
    "./eval": "./src/eval/index.ts",
    "./server": "./src/server/index.ts",
    "./storage": "./src/storage/index.ts",
    "./storage/schema": "./src/storage/schema.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/message-feedback": "./src/ui/message-feedback.tsx",
    "./ui/run-progress": "./src/ui/runs/run-progress.ts",
    "./ui/styles.css": "./src/ui/styles.css"
  },
  "bin": {
    "wf-spec": "./src/cli/spec.ts"
  },
  "scripts": {
    "clean": "rm -rf node_modules dist .turbo",
    "typecheck": "sh -c 'tsc --noEmit & a=$!; tsc --noEmit -p tsconfig.ui.json & b=$!; tsc --noEmit -p tsconfig.test.json & c=$!; rc=0; for p in $a $b $c; do wait $p || rc=1; done; exit $rc'",
    "test": "bun test",
    "docs:mcp": "bun src/mcp/docs/build.ts",
    "lint": "eslint --cache --ignore-pattern='./migrations/' .",
    "fix": "eslint --cache --fix --quiet --ignore-pattern='./migrations/' .",
    "lock": "sh -c 'd=$(mktemp -d); cp package.json bun.lock \"$d\"; (cd \"$d\" && bun install --lockfile-only); cp \"$d/bun.lock\" ./bun.lock; rm -rf \"$d\"; echo \"[007] bun.lock regenerated standalone\"'",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "sh -c '[ -f ../../.wf-migrate.env ] && . ../../.wf-migrate.env; wrangler d1 migrations apply ${WF_D1_NAME:-DB} --local --persist-to ${WF_D1_STATE:-../../.wrangler/state} --config ${WF_D1_CONFIG:-./wrangler.jsonc}'",
    "db:migrate": "sh -c '[ -f ../../.wf-migrate.env ] && . ../../.wf-migrate.env; wrangler d1 migrations apply ${WF_D1_NAME:-DB} --remote --config ${WF_D1_CONFIG:-./wrangler.jsonc}'"
  },
  "dependencies": {
    "@autoform/core": "^4.0.0",
    "@autoform/react": "^5.0.0",
    "@cfworker/json-schema": "^4.1.6",
    "@cloudflare/puppeteer": "2.0.0",
    "@dagrejs/dagre": "^3.1.3",
    "@hookform/resolvers": "^7.0.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sentry/cloudflare": "^11.11.0",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@xyflow/react": "^12.12.1",
    "ai": "^7.0.166",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "highlight.js": "~11.12.0",
    "jsonata": "^2.2.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.71.0",
    "react-hook-form": "^7.91.0",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "docx": "^9.7.1",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "docx": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@dexaai/config": "^0.0.10",
    "@ocavue/eslint-config": "^4.24.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "docx": "^9.15.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.160.0"
  }
}
